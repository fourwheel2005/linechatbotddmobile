{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "🔴 คิวใหม่: รอตรวจสภาพเครื่อง",
        "weight": "bold",
        "color": "#9A3412",
        "size": "md",
        "wrap": true
      }
    ],
    "backgroundColor": "#FFF7ED",
    "paddingAll": "12px",
    "paddingStart": "16px",
    "paddingEnd": "16px"
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "บริการ: {{SERVICE_NAME}}",
        "weight": "bold",
        "size": "md",
        "color": "#1F2937",
        "wrap": true
      },
      {
        "type": "box",
        "layout": "vertical",
        "margin": "md",
        "spacing": "md",
        "contents": [
          {
            "type": "box",
            "layout": "baseline",
            "spacing": "sm",
            "contents": [
              {
                "type": "text",
                "text": "ลูกค้า",
                "color": "#6B7280",
                "size": "sm",
                "flex": 1,
                "wrap": true
              },
              {
                "type": "text",
                "text": "{{CUSTOMER_NAME}}",
                "wrap": true,
                "color": "#1F2937",
                "size": "sm",
                "flex": 3,
                "weight": "regular"
              }
            ]
          },
          {
            "type": "box",
            "layout": "vertical",
            "contents": [
              {
                "type": "text",
                "text": "{{DEVICE_MODEL}}",
                "wrap": true,
                "color": "#1F2937",
                "size": "sm",
                "weight": "regular"
              }
            ],
            "backgroundColor": "#F8FAFC",
            "paddingAll": "12px",
            "cornerRadius": "8px"
          }
        ]
      }
    ],
    "paddingAll": "16px",
    "backgroundColor": "#FFFFFF"
  },
  "footer": {
    "type": "box",
    "layout": "horizontal",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "height": "md",
        "action": {
          "type": "postback",
          "label": "✅ สภาพผ่าน",
          "data": "action=approve&service={{SERVICE_EN}}&userId={{USER_ID}}",
          "displayText": "แอดมินกด: สภาพผ่าน (ลูกค้า: {{CUSTOMER_NAME}})"
        },
        "color": "#047857"
      },
      {
        "type": "button",
        "style": "secondary",
        "height": "md",
        "action": {
          "type": "postback",
          "label": "❌ ไม่ผ่าน",
          "data": "action=reject&service={{SERVICE_EN}}&userId={{USER_ID}}",
          "displayText": "แอดมินกด: ไม่ผ่าน (ลูกค้า: {{CUSTOMER_NAME}})"
        },
        "color": "#F1F5F9"
      }
    ],
    "paddingAll": "16px",
    "paddingTop": "4px",
    "backgroundColor": "#FFFFFF"
  }
}
