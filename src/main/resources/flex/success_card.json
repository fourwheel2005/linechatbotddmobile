{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "🎉 ลูกค้ายืนยันจำนวนงวดแล้ว!",
        "weight": "bold",
        "color": "#047857",
        "size": "md",
        "wrap": true
      }
    ],
    "backgroundColor": "#ECFDF5",
    "paddingAll": "12px",
    "paddingStart": "16px",
    "paddingEnd": "16px"
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "บริการ: {{SERVICE_NAME}}",
        "weight": "bold",
        "size": "md",
        "color": "#1F2937",
        "wrap": true
      },
      {
        "type": "box",
        "layout": "vertical",
        "margin": "md",
        "spacing": "md",
        "contents": [
          {
            "type": "box",
            "layout": "baseline",
            "spacing": "sm",
            "contents": [
              {
                "type": "text",
                "text": "ลูกค้า",
                "color": "#6B7280",
                "size": "sm",
                "flex": 1,
                "wrap": true
              },
              {
                "type": "text",
                "text": "{{CUSTOMER_NAME}}",
                "wrap": true,
                "color": "#1F2937",
                "size": "sm",
                "flex": 3,
                "weight": "regular"
              }
            ]
          },
          {
            "type": "box",
            "layout": "vertical",
            "spacing": "xs",
            "contents": [
              {
                "type": "text",
                "text": "รายละเอียด",
                "color": "#6B7280",
                "size": "sm",
                "wrap": true
              },
              {
                "type": "text",
                "text": "{{EXTRA_INFO}}",
                "wrap": true,
                "color": "#1F2937",
                "size": "sm",
                "weight": "regular"
              }
            ]
          }
        ]
      }
    ],
    "paddingAll": "16px",
    "backgroundColor": "#FFFFFF"
  },
  "footer": {
    "type": "box",
    "layout": "horizontal",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "height": "md",
        "action": {
          "type": "postback",
          "label": "💬 เข้าสรุปยอด & ขอเอกสาร",
          "data": "action=take_case&service={{SERVICE_EN}}&userId={{USER_ID}}",
          "displayText": "แอดมินเข้าดูแลเคสนี้ (สรุปยอดโอน) (ลูกค้า: {{CUSTOMER_NAME}})"
        },
        "color": "#047857"
      }
    ],
    "paddingAll": "16px",
    "paddingTop": "4px",
    "backgroundColor": "#FFFFFF"
  }
}
